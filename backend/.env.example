# QueueLess backend configuration. Copy to .env and fill in real values.
# Never commit .env. REQUIRED variables stop the server at startup if missing.

# --- Required ---------------------------------------------------------
# MongoDB connection string (Atlas or local), e.g. mongodb://127.0.0.1:27017/queueless
MONGO_URI=your_mongodb_atlas_connection_string
# Random string, 16+ characters. Signs/encrypts sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string
# Frontend origin allowed for CORS + Socket.IO (comma-separate several).
# No trailing slash needed. Local Vite dev server shown.
CLIENT_URL=http://localhost:5173

# --- Optional ---------------------------------------------------------
# HTTP port (default 5000)
PORT=5000
# Base URL of the FastAPI wait-time service (default http://127.0.0.1:8000).
# If unreachable the backend falls back to the mathematical estimate.
ML_API_URL=http://127.0.0.1:8000
# Set to "production" when deployed (hides internal error messages, blocks seeding)
NODE_ENV=development
# Cookie settings. Defaults (false / lax) suit local dev. For a frontend on a
# DIFFERENT site over HTTPS use COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Number of reverse-proxy hops (e.g. 1 on Render/Heroku/nginx). Needed for
# secure cookies behind a proxy. Leave empty when not behind a proxy.
TRUST_PROXY=
